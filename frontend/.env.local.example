# Optional: defaults to ws://localhost:8000/ws/agent (an old /ws/simulate value is rewritten to /ws/agent).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/agent
NEXT_PUBLIC_API_URL=http://localhost:8000
# The agent socket needs AGENT_WS_TOKEN set in backend/.env. Never put that token here:
# NEXT_PUBLIC_* values are shipped to the browser. The "Ask the agent" panel asks for it at runtime.
