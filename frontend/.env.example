# Optional: defaults to ws://localhost:8000/ws/agent (an old /ws/simulate value is rewritten to /ws/agent).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/agent
NEXT_PUBLIC_API_URL=http://localhost:8000
# The agent socket needs AGENT_WS_TOKEN set in backend/.env. Never put that token here:
# NEXT_PUBLIC_* values are shipped to the browser. The "Ask the agent" panel asks for it at runtime.

# Optional cloud workspace (sign-in + synced lines). Leave both empty for local-only use.
# The anon key is public by design; row-level security in supabase/migrations/010_scenarios.sql
# keeps each user's rows to that user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL for the sitemap, robots and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
